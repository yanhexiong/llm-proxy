# Optional CLI input, not Worker runtime secrets. The scripts do not require
# this file; copy values into the environment of your shell or CI job.

WORKER_NAME=api-gateway
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_NAME=api-gateway-d1
D1_BINDING=DB

# Set PUBLIC_URL after attaching a workers.dev or custom-domain URL. It is
# used only for the post-deploy /health check and by pnpm run doctor.
PUBLIC_URL=

# Worker runtime variable in wrangler.jsonc; override there when an upstream
# needs more or less than the default two-minute request timeout.
UPSTREAM_TIMEOUT_MS=120000

# ADMIN_USERNAME is used only when setup creates the first Secret.
# ADMIN_PASSWORD is read from the environment for headless setup/reset and is
# never written to the state file. Prefer the interactive hidden prompt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Advanced paths for CI or a multi-project checkout.
GATEWAY_STATE_FILE=.gateway-state.json
GATEWAY_GENERATED_CONFIG=.gateway-wrangler.jsonc
GATEWAY_PENDING_SECRETS_FILE=.gateway-pending-secrets.json
